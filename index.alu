# BASIC ALU – VERILOG CODE, TESTBENCH & SIMULATION REPORT

## 1. Verilog Code for Basic ALU

```verilog id="j5q8sj"
module basic_alu (
    input  [3:0] A,
    input  [3:0] B,
    input  [2:0] Sel,
    output reg [3:0] Y
);

always @(*) begin
    case(Sel)

        3'b000: Y = A + B;   // Addition
        3'b001: Y = A - B;   // Subtraction
        3'b010: Y = A & B;   // AND
        3'b011: Y = A | B;   // OR
        3'b100: Y = ~A;      // NOT

        default: Y = 4'b0000;

    endcase
end

endmodule
```

---

# 2. Testbench Code

```verilog id="m3zt2r"
`timescale 1ns / 1ps

module basic_alu_tb;

reg  [3:0] A;
reg  [3:0] B;
reg  [2:0] Sel;

wire [3:0] Y;

// Instantiate ALU
basic_alu uut (
    .A(A),
    .B(B),
    .Sel(Sel),
    .Y(Y)
);

initial begin

    // Monitor values
    $monitor("Time=%0t Sel=%b A=%b B=%b Y=%b",
              $time, Sel, A, B, Y);

    // Test Addition
    A = 4'b0101; B = 4'b0011; Sel = 3'b000;
    #10;

    // Test Subtraction
    A = 4'b1000; B = 4'b0010; Sel = 3'b001;
    #10;

    // Test AND
    A = 4'b1100; B = 4'b1010; Sel = 3'b010;
    #10;

    // Test OR
    A = 4'b1100; B = 4'b1010; Sel = 3'b011;
    #10;

    // Test NOT
    A = 4'b1010; Sel = 3'b100;
    #10;

    $finish;

end

endmodule
```

---

